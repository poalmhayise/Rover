# Copy to .env and fill in your real details. NEVER upload .env to a public repo.
HIRED_BANK_ACCOUNT_NAME=
HIRED_BANK_ACCOUNT_NUMBER=
HIRED_BANK_BRANCH=
HIRED_BANK_ACCOUNT_TYPE=
HIRED_BANK_SWIFT=
# Fixed price: US$0.60 USD everywhere; no SZL amount to set.
# Set to 1 ONLY after FNB confirms this specific account can receive USD payments.
HIRED_USD_BANK_VERIFIED=0
HIRED_SUPPORT_EMAIL=
# Use a unique long secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
HIRED_SECRET_KEY=
HIRED_ADMIN_PASSWORD=
# Enable ONLY when hosted on HTTPS (required for public launch)
HIRED_HTTPS_ONLY=0
HIRED_HOST=127.0.0.1
HIRED_PORT=8080

# Public HTTPS URL, e.g. https://your-own-domain.example (leave empty until live)
HIRED_PUBLIC_URL=

# Production safety gate: set 1 only when verified persistent storage/backups are configured.
HIRED_PERSISTENT_STORAGE_CONFIRMED=0

# Optional Neon cloud persistence (required for checkout on Render Free):
# Get PostgreSQL URL from Neon Dashboard -> Connect, not from GitHub.
HIRED_DATABASE_URL=
# Create a PRIVATE bucket in Neon Object Storage.
HIRED_S3_BUCKET=
HIRED_S3_ENDPOINT=
HIRED_S3_ACCESS_KEY_ID=
HIRED_S3_SECRET_ACCESS_KEY=
HIRED_S3_REGION=
# A populated Postgres database + accessible private S3 bucket automatically
# enables persistence safety, so no HIRED_PERSISTENT_STORAGE_CONFIRMED flag is needed.
